# The XUI (Manage cases) base URL of the environment under test. Jenkinsfile_CNP already
# exports this for PR builds as https://xui-ia-bail-case-api-pr-<PR>.preview.platform.hmcts.net
# AAT, which runs Bail's master code, is https://manage-case.aat.platform.hmcts.net
XUI_URL=https://xui-ia-bail-case-api-pr-0.preview.platform.hmcts.net

# One user per role the suite signs in as. In CI these come from the ia-${env} key vault, bound in
# Jenkinsfile_CNP as secret('<vault name>-username', '<VAR>_USERNAME') and the password; the vault
# names are given beside each pair. Locally, copy them out of the vault by hand: the secrets carry
# no "e2e" tag, so playwright-common's get-secrets will not find them.
# test-adminofficer-*
TEST_ADMINOFFICER_USERNAME=
TEST_ADMINOFFICER_PASSWORD=
# test-law-firm-a-*: a legal representative, who creates the legal-rep cases of the case view
# and add-case-note tests.
TEST_LAW_FIRM_A_USERNAME=
TEST_LAW_FIRM_A_PASSWORD=
# test-homeoffice-bail-*
TEST_HOMEOFFICE_BAIL_USERNAME=
TEST_HOMEOFFICE_BAIL_PASSWORD=
# test-judge-bails-*
TEST_JUDGE_BAILS_USERNAME=
TEST_JUDGE_BAILS_PASSWORD=
# test-law-firm-noc-a-bails-*: the old e2e suite's "Legal Org User Rep A Bails", a solicitor and
# case-access administrator in a MyHMCTS organisation. Creates the legal-rep cases of the ported
# journeys, including the one another organisation takes over by Notice of Change.
TEST_LAW_FIRM_NOC_A_BAILS_USERNAME=
TEST_LAW_FIRM_NOC_A_BAILS_PASSWORD=
# test-law-firm-org-deleted-*: the old suite's "Legal Org User Rep C", a solicitor in a different
# organisation, who makes the Notice of Change.
TEST_LAW_FIRM_ORG_DELETED_USERNAME=
TEST_LAW_FIRM_ORG_DELETED_PASSWORD=

# Label the Bail case type is offered under in the Create case dropdown. The definition names
# the case type "Bail${CCD_DEF_VERSION}", and ccd-definitions/bin/generate-ccd-definition.sh
# sets CCD_DEF_VERSION to the checked-out branch name truncated to 16 characters. Jenkins
# builds from a detached HEAD, so preview and AAT get "BailHEAD"; a locally generated
# definition gets "Bail" plus your branch name.
BAIL_CASE_TYPE_LABEL=BailHEAD

# Whether the environment can take a hearing request (HMC and ia-hearings-api). Defaults to true
# for any XUI_URL that is not a preview namespace, which has no HMC; the hearing-request tests are
# skipped where it is false.
# HEARINGS_AVAILABLE=true
