# The XUI (Manage cases) base URL of the environment under test. Jenkinsfile_CNP already
# exports this for PR builds as https://xui-ia-bail-case-api-pr-<PR>.preview.platform.hmcts.net
# AAT, which runs Bail's master code, is https://manage-case.aat.platform.hmcts.net
XUI_URL=https://xui-ia-bail-case-api-pr-0.preview.platform.hmcts.net

# One user per role the suite signs in as. In CI these come from the ia-${env} key vault. The
# admin officer, legal rep and Home Office variables are the names Jenkinsfile_CNP and
# Jenkinsfile_nightly already bind (test-adminofficer-*, test-law-firm-a-*,
# test-homeoffice-bail-*); neither Jenkinsfile binds a TEST_JUDGE_BAILS_* secret yet. Locally,
# copy them out of the vault by hand: the secrets carry no "e2e" tag, so playwright-common's
# get-secrets will not find them.
TEST_ADMINOFFICER_USERNAME=
TEST_ADMINOFFICER_PASSWORD=
# A legal representative in a MyHMCTS organisation, who creates the legal-rep cases.
TEST_LAW_FIRM_A_USERNAME=
TEST_LAW_FIRM_A_PASSWORD=
TEST_HOMEOFFICE_BAIL_USERNAME=
TEST_HOMEOFFICE_BAIL_PASSWORD=
TEST_JUDGE_BAILS_USERNAME=
TEST_JUDGE_BAILS_PASSWORD=

# Label the Bail case type is offered under in the Create case dropdown. The definition names
# the case type "Bail${CCD_DEF_VERSION}", and ccd-definitions/bin/generate-ccd-definition.sh
# sets CCD_DEF_VERSION to the checked-out branch name truncated to 16 characters. Jenkins
# builds from a detached HEAD, so preview and AAT get "BailHEAD"; a locally generated
# definition gets "Bail" plus your branch name.
BAIL_CASE_TYPE_LABEL=BailHEAD
