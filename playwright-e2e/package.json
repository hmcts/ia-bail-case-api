{
  "name": "ia-bail-case-playwright-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "setup": "playwright install --with-deps chromium",
    "lint": "tsc -p tsconfig.json && eslint .",
    "test": "playwright test --project=chromium --grep-invert=@a11y",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:a11y": "playwright test --project=chromium --grep @a11y"
  },
  "devDependencies": {
    "@hmcts/playwright-common": "^1.1.7",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.15.34",
    "dotenv": "^17.0.0",
    "eslint": "^9.11.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
